        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "app_calls_finished_total{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": ""
