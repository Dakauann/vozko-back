    {
      "title": "HTTP In-Flight",
      "type": "stat",
      "description": "HTTP requests currently being served, summed over the selected replicas (app_http_in_flight_requests). A sustained climb signals saturation or stuck handlers.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(app_http_in_flight_requests{replica_id=~\"$replica_id\"})",
          "legendFormat": "total",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
