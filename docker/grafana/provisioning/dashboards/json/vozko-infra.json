        "graphMode": "area",
        "colorMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "title": "WebSocket Connections",
      "type": "stat",
      "description": "Live WebSocket clients across all endpoints, summed over the selected replicas (app_ws_connections).",
