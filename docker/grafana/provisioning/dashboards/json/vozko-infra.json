  "liveNow": false,
  "description": "Application & domain metrics for vozko-go (calls, WebSockets, HTTP, speech pools, loop-guard, errors), scoped by replica. For host/process resource usage (RAM/CPU/GC) see the 'Vozko App Process' dashboard.",
  "panels": [
    {
      "title": "Active Calls (Ongoing)",
      "type": "stat",
      "description": "Calls currently connected and in progress (app_calls_current{state=ongoing}). Sparkline shows the recent trend.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "app_calls_current{state=\"ongoing\", replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
