  ],
  "liveNow": false,
  "description": "Process- and Go-runtime resource usage for the vozko-go app (RAM, CPU, goroutines, heap, GC, file descriptors), scoped by replica. The go_*/process_* collectors are registered through the replica_id-wrapped registerer so these series carry replica_id like the rest of the app metrics.",
  "panels": [
    {
      "title": "Resident Memory (RSS)",
      "type": "stat",
      "description": "Actual physical RAM the process holds, as the OS sees it (process_resident_memory_bytes). This is the number that matters for host capacity. The sparkline shows the recent trend.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1073741824 }, { "color": "red", "value": 3221225472 }] }
        }
      }
    },
    {
      "title": "CPU (cores)",
      "type": "stat",
      "description": "CPU consumed by the process expressed in cores (rate of process_cpu_seconds_total over 5m). 1.0 = one full core busy. Sparkline shows recent load.",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{replica_id=~\"$replica_id\"}[5m])",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] }
        }
      }
    },
    {
      "title": "Goroutines",
      "type": "stat",
      "description": "Live goroutines (go_goroutines). A steady climb usually means a goroutine leak.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "go_goroutines{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 20000 }] }
        }
      }
    },
    {
      "title": "Open File Descriptors",
      "type": "stat",
      "description": "Open FDs (process_open_fds) — sockets + files. Climbing toward process_max_fds risks 'too many open files'.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "process_open_fds{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 4096 }, { "color": "red", "value": 16384 }] }
        }
      }
    },
    {
      "title": "Go Heap In-Use",
      "type": "stat",
      "description": "Heap memory holding live objects right now (go_memstats_heap_inuse_bytes).",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "description": "Time since the process started (now - process_start_time_seconds). A reset means a restart/crash.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{replica_id=~\"$replica_id\"}",
          "legendFormat": "{{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Process Memory — RSS vs Virtual",
      "type": "timeseries",
      "description": "The headline RAM chart. RSS (filled) is the real physical memory held; Virtual is the address space reserved (normally much larger, not all resident). Watch RSS for capacity.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "RSS (resident) · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "process_virtual_memory_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "Virtual · {{replica_id}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Virtual.*" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 6] } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }
      }
    },
    {
      "title": "CPU Usage (cores)",
      "type": "timeseries",
      "description": "CPU consumed in cores over time (rate of process_cpu_seconds_total over 5m). 1.0 = one core fully busy. Filled for quick reading of load.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{replica_id=~\"$replica_id\"}[5m])",
          "legendFormat": "cores · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] }
      }
    },
    {
      "title": "Go Memory Breakdown by Category (stacked)",
      "type": "timeseries",
      "description": "Where the Go runtime's memory goes, stacked so the bands sum to go_memstats_sys_bytes (total obtained from the OS). heap in-use = live objects; heap idle = reserved-but-free; the rest is runtime overhead (stacks, GC metadata, allocator caches). Best read with a single replica selected.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "heap in-use · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_heap_idle_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "heap idle (reserved) · {{replica_id}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_stack_sys_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "stacks · {{replica_id}}",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_gc_sys_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "GC metadata · {{replica_id}}",
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_mspan_sys_bytes{replica_id=~\"$replica_id\"} + go_memstats_mcache_sys_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "allocator caches · {{replica_id}}",
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_buck_hash_sys_bytes{replica_id=~\"$replica_id\"} + go_memstats_other_sys_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "profiling + other · {{replica_id}}",
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }
      }
    },
    {
      "title": "Heap: live allocation vs GC target (the GC sawtooth)",
      "type": "timeseries",
      "description": "Live heap (go_memstats_heap_alloc_bytes) climbs as you allocate; when it reaches the GC target (go_memstats_next_gc_bytes, dashed) a garbage collection fires and live heap drops — the classic sawtooth. A target that keeps ratcheting up indicates growing retained memory.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "live heap · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_memstats_next_gc_bytes{replica_id=~\"$replica_id\"}",
          "legendFormat": "next GC target · {{replica_id}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "next GC target.*" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }
      }
    },
    {
      "title": "Heap Allocation Rate",
      "type": "timeseries",
      "description": "Bytes allocated per second (rate of go_memstats_alloc_bytes_total). High churn drives GC frequency and CPU even if live heap looks flat.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "rate(go_memstats_alloc_bytes_total{replica_id=~\"$replica_id\"}[5m])",
          "legendFormat": "allocated/s · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 22,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "Goroutines & OS Threads",
      "type": "timeseries",
      "description": "Concurrency footprint: goroutines (go_goroutines) vs OS threads the runtime holds (go_threads). Diverging goroutines = likely leak; rising threads = blocking syscalls.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "go_goroutines{replica_id=~\"$replica_id\"}",
          "legendFormat": "goroutines · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "go_threads{replica_id=~\"$replica_id\"}",
          "legendFormat": "OS threads · {{replica_id}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "GC Pause Duration (quantiles)",
      "type": "timeseries",
      "description": "Stop-the-world GC pause durations by quantile (go_gc_duration_seconds). The high quantiles are your worst-case latency hits from GC.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        {
          "expr": "go_gc_duration_seconds{replica_id=~\"$replica_id\"}",
          "legendFormat": "q{{quantile}} · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "GC Rate (collections/s)",
      "type": "timeseries",
      "description": "How often garbage collection runs (rate of go_gc_duration_seconds_count). Rising rate with flat live heap points at allocation churn.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_count{replica_id=~\"$replica_id\"}[5m])",
          "legendFormat": "GC/s · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 22, "gradientMode": "opacity", "showPoints": "never", "spanNulls": true }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "File Descriptors (open vs max)",
      "type": "timeseries",
      "description": "Open FDs (process_open_fds) against the soft limit (process_max_fds). The gap is your headroom before 'too many open files'.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "process_open_fds{replica_id=~\"$replica_id\"}",
          "legendFormat": "open · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        },
        {
          "expr": "process_max_fds{replica_id=~\"$replica_id\"}",
          "legendFormat": "max · {{replica_id}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "max.*" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "Live Heap Objects",
      "type": "timeseries",
      "description": "Count of live objects on the heap (go_memstats_heap_objects). Tracks allocation pressure independent of object size; a steady climb hints at a leak.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "targets": [
        {
          "expr": "go_memstats_heap_objects{replica_id=~\"$replica_id\"}",
          "legendFormat": "objects · {{replica_id}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "spanNulls": true }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["vozko", "resources", "process"],
