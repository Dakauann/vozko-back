  "id": null,
  "links": [
    {
      "title": "Vozko Infra (app/domain metrics)",
      "type": "dashboards",
      "tags": ["vozko", "infrastructure"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
