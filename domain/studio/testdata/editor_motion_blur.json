{
  "schema": "studio.video",
  "version": 1,
  "canvas": { "aspect": "landscape", "background": "#101010", "shutterAngle": 270, "shutterPhase": -135 },
  "durationMs": 3000,
  "tracks": [
    {
      "id": "main",
      "kind": "visual",
      "clips": [
        {
          "id": "pan",
          "type": "video",
          "assetId": "m-video",
          "startMs": 0,
          "durationMs": 3000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "fit": "cover",
          "transform": { "x": 0.5, "y": 0.5, "w": 1, "h": 1, "rotation": 0, "opacity": 1 },
          "motionBlur": true,
          "keyframes": {
            "scale": [
              { "atMs": 0, "value": 1, "easing": "easeIn" },
              { "atMs": 600, "value": 1.6, "easing": "linear" }
            ]
          }
        }
      ]
    },
    {
      "id": "graphics",
      "kind": "visual",
      "clips": [
        {
          "id": "badge",
          "type": "image",
          "assetId": "m-badge",
          "startMs": 200,
          "durationMs": 1800,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "fit": "contain",
          "transform": { "x": 0.2, "y": 0.5, "w": 0.2, "h": 0.2, "rotation": 0, "opacity": 1 },
          "motionBlur": true,
          "parentId": "rig"
        }
      ]
    },
    {
      "id": "titles",
      "kind": "visual",
      "clips": [
        {
          "id": "title",
          "type": "overlay",
          "startMs": 0,
          "durationMs": 2000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "transform": { "x": 0.5, "y": 0.8, "w": 0.6, "h": 0.12, "rotation": 0, "opacity": 1 },
          "layer": {
            "id": "title-text",
            "type": "text",
            "text": "Oferta",
            "fontId": "inter",
            "fontSize": 0.06,
            "fill": "#ffffff",
            "align": "center",
            "transform": { "x": 0.5, "y": 0.5, "w": 1, "h": 1, "rotation": 0, "opacity": 1 }
          },
          "motionBlur": true,
          "motionIn": { "edge": "left", "durationMs": 300 }
        }
      ]
    },
    {
      "id": "controls",
      "kind": "visual",
      "clips": [
        {
          "id": "rig",
          "type": "null",
          "startMs": 0,
          "durationMs": 3000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "transform": { "x": 0.5, "y": 0.5, "w": 0.1, "h": 0.1, "rotation": 0, "opacity": 1 },
          "keyframes": {
            "rotation": [
              { "atMs": 0, "value": 0, "easing": "linear" },
              { "atMs": 3000, "value": 720, "easing": "linear" }
            ]
          }
        }
      ]
    }
  ]
}
