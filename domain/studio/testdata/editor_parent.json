{
  "schema": "studio.video",
  "version": 1,
  "canvas": { "aspect": "story", "background": "#000000" },
  "durationMs": 4000,
  "tracks": [
    {
      "id": "main",
      "kind": "visual",
      "clips": [
        {
          "id": "photo",
          "type": "image",
          "assetId": "m-1",
          "startMs": 0,
          "durationMs": 4000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "fit": "cover",
          "transform": { "x": -0.2, "y": 0.45, "w": 0.4, "h": 0.3, "rotation": 10, "opacity": 1 },
          "anchor": { "x": 0, "y": 1 },
          "parentId": "rig"
        }
      ]
    },
    {
      "id": "titles",
      "kind": "visual",
      "clips": [
        {
          "id": "title",
          "type": "overlay",
          "startMs": 500,
          "durationMs": 3000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "transform": { "x": 0.5, "y": 1.3, "w": 0.6, "h": 0.1, "rotation": 0, "opacity": 0.8 },
          "layer": {
            "id": "title-text",
            "type": "text",
            "text": "Oferta",
            "fontId": "inter",
            "fontSize": 0.06,
            "fill": "#ffffff",
            "align": "center",
            "transform": { "x": 0.5, "y": 0.5, "w": 1, "h": 1, "rotation": 0, "opacity": 1 }
          },
          "parentId": "photo"
        }
      ]
    },
    {
      "id": "controls",
      "kind": "visual",
      "clips": [
        {
          "id": "rig",
          "type": "null",
          "startMs": 0,
          "durationMs": 4000,
          "trimInMs": 0,
          "volume": 1,
          "fadeInMs": 0,
          "fadeOutMs": 0,
          "transform": { "x": 0.5, "y": 0.5, "w": 0.1, "h": 0.1, "rotation": 0, "opacity": 1 },
          "anchor": { "x": 0.5, "y": 1 },
          "keyframes": {
            "rotation": [
              { "atMs": 0, "value": 0, "easing": "easeInOut" },
              { "atMs": 2000, "value": 45, "easing": "linear" }
            ],
            "scale": [
              { "atMs": 0, "value": 1, "easing": "backOut" },
              { "atMs": 1500, "value": 1.5, "easing": "linear" }
            ],
            "position": [
              { "atMs": 0, "x": 0.4, "y": 0.6, "easing": "linear" },
              { "atMs": 4000, "x": 0.6, "y": 0.5, "easing": "linear" }
            ]
          }
        }
      ]
    }
