## performance indexes

-- idx_cm_inbox_whatsapp
CREATE INDEX IF NOT EXISTS idx_cm_inbox_whatsapp ON conversation_messages (entry_id, created_at DESC) WHERE entry_type = 'whatsapp' AND deleted_at IS NULL;

-- idx_cm_entry_del_created
CREATE INDEX IF NOT EXISTS idx_cm_entry_del_created ON conversation_messages (entry_id, entry_type, created_at DESC) WHERE deleted_at IS NULL;

-- idx_cm_wamid_partial
CREATE INDEX IF NOT EXISTS idx_cm_wamid_partial ON conversation_messages (whatsapp_message_id) WHERE whatsapp_message_id IS NOT NULL AND whatsapp_message_id != '' AND deleted_at IS NULL;

-- idx_cm_meta_service_cost
CREATE INDEX IF NOT EXISTS idx_cm_meta_service_cost ON conversation_messages (created_at) INCLUDE (entry_id, delivery_status) WHERE deleted_at IS NULL AND entry_type = 'whatsapp' AND direction = 'OUTBOUND' AND message_type IN ('operator', 'ai_response', 'media', 'audio') AND COALESCE(sent_via, '') <> 'business_app';

-- idx_inbox_assignments_entry_id
CREATE INDEX IF NOT EXISTS idx_inbox_assignments_entry_id ON inbox_assignments (entry_id);

-- idx_inbox_assignments_entry_user
CREATE INDEX IF NOT EXISTS idx_inbox_assignments_entry_user ON inbox_assignments (entry_id, assigned_user_id);

-- idx_wmp_member_resource_action
CREATE INDEX IF NOT EXISTS idx_wmp_member_resource_action ON workspace_member_permissions (member_id, resource, action);

-- idx_wce_campaign_del
CREATE INDEX IF NOT EXISTS idx_wce_campaign_del ON whatsapp_campaign_entries (campaign_id, deleted_at);

-- idx_wce_campaign_status_created
CREATE INDEX IF NOT EXISTS idx_wce_campaign_status_created ON whatsapp_campaign_entries (campaign_id, status, created_at);

-- idx_wce_message_id
CREATE INDEX IF NOT EXISTS idx_wce_message_id ON whatsapp_campaign_entries (message_id) WHERE message_id IS NOT NULL AND message_id != '';

-- idx_wce_campaign_updated
CREATE INDEX IF NOT EXISTS idx_wce_campaign_updated ON whatsapp_campaign_entries (campaign_id, updated_at DESC) WHERE deleted_at IS NULL;

-- idx_wce_campaign_convstatus_active
CREATE INDEX IF NOT EXISTS idx_wce_campaign_convstatus_active ON whatsapp_campaign_entries (campaign_id, conversation_status) WHERE deleted_at IS NULL AND conversation_status <> '';

-- idx_balances_workspace_id
CREATE INDEX IF NOT EXISTS idx_balances_workspace_id ON balances (workspace_id);

-- idx_leads_number
CREATE INDEX IF NOT EXISTS idx_leads_number ON leads (number);

-- idx_leads_workspace_created
CREATE INDEX IF NOT EXISTS idx_leads_workspace_created ON leads (workspace_id, created_at) WHERE deleted_at IS NULL;

-- idx_wa_campaign_ws_del
CREATE INDEX IF NOT EXISTS idx_wa_campaign_ws_del ON whatsapp_campaigns (workspace_id, deleted_at);

-- idx_wa_campaign_ws_created
CREATE INDEX IF NOT EXISTS idx_wa_campaign_ws_created ON whatsapp_campaigns (workspace_id, created_at) WHERE deleted_at IS NULL;

-- idx_wce_campaign_created_active
CREATE INDEX IF NOT EXISTS idx_wce_campaign_created_active ON whatsapp_campaign_entries (campaign_id, created_at) WHERE deleted_at IS NULL;

-- idx_cm_type_created_active
CREATE INDEX IF NOT EXISTS idx_cm_type_created_active ON conversation_messages (entry_type, created_at) INCLUDE (entry_id) WHERE deleted_at IS NULL;

-- idx_ah_ws_started
CREATE INDEX IF NOT EXISTS idx_ah_ws_started ON assignment_history (workspace_id, started_at DESC);

-- idx_ah_rescue_candidates
CREATE INDEX IF NOT EXISTS idx_ah_rescue_candidates ON assignment_history (workspace_id, started_at) WHERE ended_at IS NULL AND "trigger" IN ('inbound_rr', 'automation_handoff_rr', 'rescue');

-- idx_ia_ws_created
CREATE INDEX IF NOT EXISTS idx_ia_ws_created ON inbox_assignments (workspace_id, created_at) WHERE assigned_user_id IS NOT NULL;

-- idx_ia_ws_user
CREATE INDEX IF NOT EXISTS idx_ia_ws_user ON inbox_assignments (workspace_id, assigned_user_id);

-- idx_entry_stages_stage_entry
CREATE INDEX IF NOT EXISTS idx_entry_stages_stage_entry ON entry_stages (stage_id, entry_type, entry_id);

