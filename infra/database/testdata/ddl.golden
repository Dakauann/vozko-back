-- idx_cm_lateral_join
CREATE INDEX IF NOT EXISTS idx_cm_lateral_join ON conversation_messages (entry_id, entry_type, created_at DESC, id DESC) WHERE deleted_at IS NULL;

-- idx_agents_workspace
