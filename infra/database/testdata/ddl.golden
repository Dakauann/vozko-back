## call list keys

-- fk_call_list_items_workspace_list
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_call_list_items_workspace_list' AND conrelid = 'call_list_items'::regclass) THEN ALTER TABLE call_list_items ADD CONSTRAINT fk_call_list_items_workspace_list FOREIGN KEY (workspace_id, list_id) REFERENCES call_lists (workspace_id, id) ON DELETE CASCADE; END IF; END $$;

-- fk_call_list_items_last_call
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_call_list_items_last_call' AND conrelid = 'call_list_items'::regclass) THEN ALTER TABLE call_list_items ADD CONSTRAINT fk_call_list_items_last_call FOREIGN KEY (last_call_id) REFERENCES calls (id) ON DELETE SET NULL; END IF; END $$;

## composite lead keys

-- fk_lead_phones_workspace_lead
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_lead_phones_workspace_lead' AND conrelid = 'lead_phones'::regclass) THEN ALTER TABLE lead_phones ADD CONSTRAINT fk_lead_phones_workspace_lead FOREIGN KEY (workspace_id, lead_id) REFERENCES leads (workspace_id, id) ON DELETE CASCADE NOT VALID; END IF; END $$;

-- fk_lead_addresses_workspace_lead
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_lead_addresses_workspace_lead' AND conrelid = 'lead_addresses'::regclass) THEN ALTER TABLE lead_addresses ADD CONSTRAINT fk_lead_addresses_workspace_lead FOREIGN KEY (workspace_id, lead_id) REFERENCES leads (workspace_id, id) ON DELETE CASCADE NOT VALID; END IF; END $$;

-- fk_lead_relations_workspace_lead
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_lead_relations_workspace_lead' AND conrelid = 'lead_relations'::regclass) THEN ALTER TABLE lead_relations ADD CONSTRAINT fk_lead_relations_workspace_lead FOREIGN KEY (workspace_id, lead_id) REFERENCES leads (workspace_id, id) ON DELETE CASCADE NOT VALID; END IF; END $$;

-- fk_lead_relations_workspace_other_lead
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_lead_relations_workspace_other_lead' AND conrelid = 'lead_relations'::regclass) THEN ALTER TABLE lead_relations ADD CONSTRAINT fk_lead_relations_workspace_other_lead FOREIGN KEY (workspace_id, other_lead_id) REFERENCES leads (workspace_id, id) ON DELETE CASCADE NOT VALID; END IF; END $$;

-- fk_lead_call_list_items_workspace_lead
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_lead_call_list_items_workspace_lead' AND conrelid = 'call_list_items'::regclass) THEN ALTER TABLE call_list_items ADD CONSTRAINT fk_lead_call_list_items_workspace_lead FOREIGN KEY (workspace_id, lead_id) REFERENCES leads (workspace_id, id) ON DELETE CASCADE NOT VALID; END IF; END $$;

