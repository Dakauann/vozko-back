CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_uwce_group_target ON unofficial_whatsapp_campaign_entries (workspace_id, jid) WHERE lead_id IS NULL AND deleted_at IS NULL;

-- ux_custom_field_ws_object_key_live
CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS ux_custom_field_ws_object_key_live ON custom_field_definitions (workspace_id, object_type, key) WHERE deleted_at IS NULL;

-- ux_custom_field_ws_object_role_live
CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS ux_custom_field_ws_object_role_live ON custom_field_definitions (workspace_id, object_type, role) WHERE role IS NOT NULL AND role <> '' AND deleted_at IS NULL;

-- idx_leads_custom_fields
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_custom_fields ON leads USING gin (custom_fields jsonb_path_ops) WHERE custom_fields IS NOT NULL;

-- ux_leads_workspace_id_id
CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS ux_leads_workspace_id_id ON leads (workspace_id, id);

-- idx_leads_workspace_live
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_workspace_live ON leads (workspace_id, id) WHERE deleted_at IS NULL;

-- idx_leads_workspace_owner
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_workspace_owner ON leads (workspace_id, owner_id) WHERE owner_id IS NOT NULL AND deleted_at IS NULL;

-- idx_leads_workspace_birthday
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_workspace_birthday ON leads (workspace_id, (extract(month from birth_date)), (extract(day from birth_date))) WHERE birth_date IS NOT NULL AND deleted_at IS NULL;

-- idx_leads_workspace_referred
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_workspace_referred ON leads (workspace_id, referred_count) WHERE referred_count > 0;

-- idx_leads_workspace_company
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_workspace_company ON leads (workspace_id, company_id) WHERE company_id IS NOT NULL AND deleted_at IS NULL;

-- idx_lead_addresses_workspace_place
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_workspace_place ON lead_addresses (workspace_id, city_key, district_key) WHERE is_primary;

-- idx_lead_addresses_geo_queue_ws
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_geo_queue_ws ON lead_addresses (workspace_id, geo_next_at) INCLUDE (geo_status) WHERE geo_status IN ('pending', 'unavailable');

-- idx_lead_addresses_window
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_window ON lead_addresses (workspace_id, latitude, longitude) INCLUDE (lead_id, geo_precision) WHERE latitude IS NOT NULL AND is_primary;

-- idx_lead_addresses_located_id
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_located_id ON lead_addresses (id) WHERE latitude IS NOT NULL;

-- idx_lead_addresses_import
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_import ON lead_addresses (import_id) INCLUDE (workspace_id, lead_id, latitude, geo_status, geo_precision) WHERE import_id IS NOT NULL;

-- idx_opportunities_workspace_lead
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_opportunities_workspace_lead ON opportunities (workspace_id, lead_id, created_at) WHERE lead_id IS NOT NULL AND deleted_at IS NULL;

-- idx_calls_ws_counterpart_unlinked
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_calls_ws_counterpart_unlinked ON calls (workspace_id, (CASE WHEN direction = 'inbound' THEN phone_from ELSE phone_to END), started_at DESC) WHERE lead_id IS NULL AND deleted_at IS NULL;

-- idx_call_list_items_agenda
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_call_list_items_agenda ON call_list_items (list_id, (COALESCE(callback_at, 'infinity'::timestamptz)), position) WHERE state = 'pending';

-- idx_wce_campaign_status_live
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_wce_campaign_status_live ON whatsapp_campaign_entries (campaign_id, status) INCLUDE (lead_id) WHERE deleted_at IS NULL;

-- idx_wce_campaign_wave_status
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_wce_campaign_wave_status ON whatsapp_campaign_entries (campaign_id, wave_number, status) WHERE wave_number > 0 AND deleted_at IS NULL;

-- idx_lead_phones_workspace_number_lead
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_phones_workspace_number_lead ON lead_phones (workspace_id, number, lead_id);

-- idx_geo_cities_name_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_cities_name_prefix ON geo_cities (name_key text_pattern_ops);

-- idx_geo_district_points_city_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_district_points_city_prefix ON geo_district_points (city_code, district_key text_pattern_ops);

-- idx_geo_district_points_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_district_points_prefix ON geo_district_points (district_key text_pattern_ops);

-- idx_geo_cep_points_zip_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_cep_points_zip_prefix ON geo_cep_points (zip_code text_pattern_ops);

-- idx_geo_cep_streets_city_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_cep_streets_city_prefix ON geo_cep_streets (city_code, street_key text_pattern_ops);

-- idx_geo_cep_streets_prefix
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_cep_streets_prefix ON geo_cep_streets (street_key text_pattern_ops);

-- idx_geo_cep_streets_state_built
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_geo_cep_streets_state_built ON geo_cep_streets (state, built_at);

-- idx_leads_search_name
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_search_name ON leads USING gin (workspace_id, vozko_fold(name) public.gin_trgm_ops) WHERE deleted_at IS NULL;

-- idx_leads_search_nickname
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_search_nickname ON leads USING gin (workspace_id, vozko_fold(nickname) public.gin_trgm_ops) WHERE nickname IS NOT NULL AND deleted_at IS NULL;

-- idx_leads_search_number
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_leads_search_number ON leads USING gin (workspace_id, number public.gin_trgm_ops) WHERE deleted_at IS NULL;

-- idx_lead_phones_search_number
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_phones_search_number ON lead_phones USING gin (workspace_id, number public.gin_trgm_ops);

-- idx_lead_memories_search_content
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_memories_search_content ON lead_memories USING gin (workspace_id, vozko_fold(content) public.gin_trgm_ops) WHERE deleted_at IS NULL;

-- idx_lead_addresses_place_lead
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_lead_addresses_place_lead ON lead_addresses (workspace_id, city_key, district_key) INCLUDE (lead_id) WHERE is_primary;

