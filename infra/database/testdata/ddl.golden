-- idx_short_links_ws_created
CREATE INDEX IF NOT EXISTS idx_short_links_ws_created ON short_links (workspace_id, created_at DESC) WHERE deleted_at IS NULL;

-- idx_short_link_clicks_link_time
CREATE INDEX IF NOT EXISTS idx_short_link_clicks_link_time ON short_link_clicks (short_link_id, occurred_at DESC);

